# Production build settings (not secrets). The Presage relay the live site reads pulses through: a tunnel to
# the relay on the demo laptop (scripts/presage-relay.sh). The key is only on the relay. If the tunnel is
# restarted it gets a new address: update this line (or set VITE_PRESAGE_URL in Vercel, which wins) and redeploy.
VITE_PRESAGE_URL=wss://code-castle-duke-portsmouth.trycloudflare.com/presage
