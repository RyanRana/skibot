# SpacetimeDB. Local dev: ws://127.0.0.1:3000 after `spacetime start`. Demo: wss://maincloud.spacetimedb.com
VITE_STDB_URI=ws://127.0.0.1:3000
VITE_STDB_DB=ground-truth

# Server-side keys go in game/.env.local (gitignored), never in this file. The dev server reads them; the
# browser never sees them.
# PRESAGE_API_KEY=       Presage SmartSpectra: heart rate and breathing from the camera
# ELEVENLABS_API_KEY=    ElevenLabs: the race commentator's voice (on the deployed site: a Vercel environment
#                        variable read by api/tts.js, not this file)
# ELEVENLABS_VOICE_ID=   optional: a specific voice (otherwise a commentator-style voice from the account)
# VITE_PRESAGE_URL=      live site only: the Presage relay, e.g. wss://relay.example.com/presage (not a secret;
#                        set it in Vercel, the relay holds the key). Locally the dev server measures instead.
