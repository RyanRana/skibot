# From https://app.photon.codes -> your project -> Settings. Leave empty to run in terminal mode for testing.
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
# SpacetimeDB the game uses (local: ws://127.0.0.1:3000, demo: wss://maincloud.spacetimedb.com)
STDB_URI=ws://127.0.0.1:3000
STDB_DB=ground-truth
# Where the game and the board are served (LAN IP so phones can open the link)
GAME_URL=http://localhost:5173/
COURSE_NAME=Streif
